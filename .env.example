# RecoverAI Configuration
# Copy this file to .env and fill in values

# Database (SQLite - no setup needed)
DATABASE_URL=sqlite:///./recoverai.db

# App Settings
APP_MODE=simulation
# Options: simulation, razorpay_test
SIMULATION_SEED=42

# Razorpay Test Mode (optional - app works without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LLM / Groq API Key (optional - used for explanation generation and ops chat)
LLM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
